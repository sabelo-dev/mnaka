{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "maxLength": 32
    },
    "min_host_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "project.read",
          "project.search",
          "build.status"
        ]
      }
    },
    "inputs_schema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "required": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "integer",
                  "boolean"
                ]
              },
              "format": {
                "type": "string",
                "enum": [
                  "uuid",
                  "date-time"
                ]
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4000
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4000
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "type",
        "required",
        "properties",
        "additionalProperties"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "build.status"
            ]
          },
          "args": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "pattern": "^\\$\\{input\\.[a-zA-Z_][a-zA-Z0-9_]*\\}$",
                "maxLength": 128
              }
            },
            "required": [
              "project_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "tool",
          "args"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "max_steps",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "maxLength": 71
    }
  },
  "required": [
    "id",
    "version",
    "min_host_version",
    "description",
    "permissions",
    "inputs_schema",
    "workflow",
    "limits",
    "artifact_hash"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnaka.invalid/schemas/skill.schema.json"
}
