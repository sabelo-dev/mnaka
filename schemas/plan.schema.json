{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "intent": {
            "type": "object",
            "properties": {
              "schema_version": {
                "type": "string",
                "const": "1.0"
              },
              "task_id": {
                "type": "string",
                "format": "uuid",
                "minLength": 36,
                "maxLength": 36
              },
              "step_id": {
                "type": "string",
                "format": "uuid",
                "minLength": 36,
                "maxLength": 36
              },
              "engine": {
                "type": "string",
                "enum": [
                  "assistant",
                  "software",
                  "control",
                  "skills",
                  "memory",
                  "vision",
                  "proactive"
                ]
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "tool_version": {
                "type": "string",
                "const": "1.0"
              },
              "arguments": {
                "type": "object"
              },
              "resources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "idempotency_key": {
                "type": "string",
                "format": "uuid",
                "minLength": 36,
                "maxLength": 36
              },
              "deadline_utc": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "schema_version",
              "task_id",
              "step_id",
              "engine",
              "tool",
              "tool_version",
              "arguments",
              "resources",
              "idempotency_key",
              "deadline_utc"
            ],
            "additionalProperties": false,
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://mnaka.invalid/schemas/intent.schema.json"
          },
          "depends_on": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36
            }
          },
          "required": {
            "type": "boolean"
          },
          "postcondition": {
            "type": "object",
            "properties": {
              "predicate": {
                "type": "string",
                "enum": [
                  "result.ok"
                ]
              },
              "arguments": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "predicate",
              "arguments"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "intent",
          "depends_on",
          "required",
          "postcondition"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "steps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnaka.invalid/schemas/plan.schema.json"
}
