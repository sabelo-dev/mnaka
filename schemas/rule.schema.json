{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "enabled": {
      "type": "boolean"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trigger": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "schedule",
            "project_change",
            "build_failure"
          ]
        },
        "local_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "const": "build.status"
        },
        "project_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "suggestion_only": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tool",
        "project_id",
        "suggestion_only"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "cooldown_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "max_runs_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "catch_up_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "quiet_start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "quiet_end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "required": [
        "cooldown_seconds",
        "max_runs_day",
        "catch_up_seconds",
        "quiet_start",
        "quiet_end"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "enabled",
    "timezone",
    "trigger",
    "action",
    "constraints",
    "version"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnaka.invalid/schemas/rule.schema.json"
}
