{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "entities": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "enum": [
              "memory",
              "decision",
              "preference"
            ]
          },
          "entity_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "deleted": {
            "type": "boolean"
          },
          "payload": {
            "type": "object",
            "properties": {
              "content_ref": {
                "type": "string",
                "pattern": "^content:[0-9a-f-]{36}$",
                "maxLength": 44
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "confirmed",
                  "observation",
                  "superseded"
                ]
              },
              "source_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "entity_type",
          "entity_id",
          "expected_version",
          "deleted",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "entities"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnaka.invalid/schemas/sync.schema.json"
}
