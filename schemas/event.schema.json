{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "task_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "task.created",
        "task.state_changed",
        "step.started",
        "step.progress",
        "step.completed",
        "approval.requested",
        "artifact.created",
        "task.completed"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "task_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "step_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "previous_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "new_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approval_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        }
      },
      "required": [
        "schema_version",
        "task_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "task_id",
    "sequence",
    "type",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnaka.invalid/schemas/event.schema.json"
}
